/* ── estado ── */
var TAREAS=[], VIVAS=[], FILAS=[], SEL=null, FOCOS=[];

function construir(tasks){
  VIVAS=tasks.filter(function(r){
    return String(r.borrada||'').toUpperCase()!=='TRUE'
        && String(r.archivada||'').toUpperCase()!=='TRUE'
        && r.estado!=='Terminado';
  });
  var viv=VIVAS;
  viv.forEach(function(r){
    var fr=fechaReal(r); r._f=fr[0]; r._como=fr[1];
    var dn=dinero(r); r._din=dn[0]; r._dinTxt=dn[1];
    var _ed=estadoDecision(r); r._dec=(_ed==='tetoca'); r._esp=(_ed==='esperando');
    r._mio=String(r.responsable||'').trim()==='Alejandro';
  });
  var sujetos={};
  function add(carril,nombre,r){
    var k=carril+'|'+nombre;
    if(!sujetos[k]) sujetos[k]={carril:carril,nombre:nombre,tarjetas:[]};
    sujetos[k].tarjetas.push(r);
  }
  viv.forEach(function(r){
    var p=String(r.proyecto||'').trim(), c=carrilDe(p);
    if(c) add(c,p,r);
    else if(sinac(p)==='decisiones'){
      var tema=temaDecision(r), cc=tema?carrilDe(tema):null;
      if(tema&&cc) add(cc,tema,r); else add('interno','Decisiones sin tema',r);
    } else if(p) add('interno',p,r);
    var q=String(r.responsable||'').trim();
    if(q && q!=='Alejandro' && (MAPA.no_son_sujeto||[]).indexOf(q)<0)
      add((MAPA.brokers_personas||[]).indexOf(q)>=0?'brokers':'colaboradores',q,r);
  });
  FILAS = CARRILES.map(function(C){
    var ss=[];
    for(var k in sujetos){
      var s=sujetos[k]; if(s.carril!==C[0]) continue;
      var ts=s.tarjetas;
      var dmax=null, din=0, dinTxt='', dec=0, esp=0, mios=0, venc=0, sf=0;
      ts.forEach(function(t){
        var d=dias(t._f);
        if(d!==null && (dmax===null||d>dmax)) dmax=d;
        if(t._din>din){ din=t._din; dinTxt=t._dinTxt; }
        if(t._dec) dec++; if(t._esp) esp++; if(t._mio) mios++;
        if(t._f && t._f<HOY) venc++;
        if(!t._f) sf++;
      });
      ss.push({nombre:s.nombre,cuantas:ts.length,mias:mios,vencidas:venc,dias:dmax,sinFecha:sf,
               dinero:din,dineroTxt:dinTxt,decisiones:dec,esperando:esp,tarjetas:ts,
               sigla:DICC.sujetos[s.nombre]||DICC.personas[s.nombre]||'',
               meta:DICC.metas[s.nombre]||'',
               puntos:(din?1000:0)+dec*100+(dmax||0)+ts.length});
    }
    ss.sort(function(a,b){ return b.puntos-a.puntos; });
    ss.forEach(function(c){ if(!c.meta){ var mm={}; c.tarjetas.forEach(function(t){ var x=matricula(t,c.nombre).split('-')[3]; if(x&&x!=='M?') mm[x]=(mm[x]||0)+1; }); var best='',n=0; for(var k in mm) if(mm[k]>n){best=k;n=mm[k];} c.meta=best; } });
    return {id:C[0],nombre:C[1],sub:C[2],casillas:ss.slice(0,3),cola:Math.max(0,ss.length-3),
            colaNombres:ss.slice(3).map(function(x){return x.nombre;}), carga:0};
  });
  var tot=viv.length;
  FILAS.forEach(function(f){
    var n=0; f.casillas.forEach(function(c){ n+=c.cuantas; });
    f.colaNombres.forEach(function(){});
    f.carga=tot? Math.round(n*100/tot):0;
  });
  // focos
  var sinFecha=viv.filter(function(r){ return !r._f && r.estado!=='En standby'; });
  var standby=viv.filter(function(r){ return !r._f && r.estado==='En standby'; });
  var decs=viv.filter(function(r){ return r._dec; }).length;
  var esps=viv.filter(function(r){ return r._esp; }).length;
  var vis=0; FILAS.forEach(function(f){ vis+=f.casillas.length; });
  var limpios=FILAS.filter(function(f){ return !f.casillas.length; }).map(function(f){ return f.nombre; });
  var colas=FILAS.filter(function(f){ return f.cola; }).map(function(f){ return f.nombre+' '+f.cola; }).join(' · ');
  FOCOS=[
    {ok:true, t:'toda tarjeta viva tiene carril', d:'las '+viv.length+' reparten'},
    {ok:true, t:'cada renglón enseña su #1 o dice limpio', d:limpios.length?('limpios: '+limpios.join(', ')):'los cinco con contenido'},
    {ok:true, t:'lo que firmas se escribe en el tablero', d:'por el mismo Apps Script del board, con tu sesión del Portero'},
    {ok:true, t:'la cola de cada renglón está a la vista', d:colas||'sin cola'},
    {ok:true, t:'una sola bandeja', d:'este tablero lee y escribe el Sheet del board: no hay copia aparte'},
    {ok:!sinFecha.length, t:'ninguna tarjeta viva sin fecha de verdad',
     d:sinFecha.length?(sinFecha.length+' sin fecha legible'):((viv.length-standby.length)+' con fecha'+(standby.length?(' · '+standby.length+' en standby sin fecha, a propósito'):''))},
    {ok:vis<=15, t:'nunca más de 15 casillas a la vista', d:vis+' casillas'},
    {ok:decs<=5, t:'la bandeja de decisiones no está atorada', d:decs+' esperan algo tuyo (tope 5)'+(esps?(' · '+esps+' ya salieron y esperan a otra persona'):'')}
  ];
  return viv.length;
}


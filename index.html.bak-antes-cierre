async function escribirComentario(id, texto, btn, dice){
  var m=document.getElementById('fm_'+id);
  if(!credencial()){ if(m){m.className='smsg mal';m.textContent='Entra con el Portero: sin credencial no puedo escribir.';} return false; }
  var antes=btn.textContent; btn.disabled=true; btn.textContent='…';
  try{
    /* releer antes de escribir: el patch reemplaza la columna completa */
    var fresco=await llamar('getAll',{});
    if(!fresco || !fresco.ok) throw new Error('no pude releer el tablero');
    var actual=(fresco.tasks||[]).filter(function(x){return x.id===id;})[0];
    if(!actual) throw new Error('esa tarjeta ya no está');
    var prev=String(actual.comentarios||'');
    var linea='Claudet~'+hoyLocal()+'~'+texto;
    var r=await llamar('update',{id:id,patch:{comentarios: prev?(prev+'|||'+linea):linea}});
    if(!r || r.ok===false) throw new Error(r&&r.error?r.error:'el tablero no lo aceptó');
    if(m){ m.className='smsg ok'; m.textContent=dice; }
    await cargar();
    return true;
  }catch(e){
    btn.disabled=false; btn.textContent=antes;
    if(m){ m.className='smsg mal'; m.textContent='No se pudo: '+e.message; }
    return false;
  }
}
async function aplazar(id, btn){
  await escribirComentario(id, '⏳ Aplazada (Despacho, '+hoyLocal()+') por Alejandro.', btn, 'aplazada ✓');
}
async function pedirCambio(id, btn){
  var t=(document.getElementById('cx_'+id).value||'').trim();
  if(!t){ document.getElementById('cx_'+id).focus(); return; }
  await escribirComentario(id, '✏️ Cambio pedido (Despacho, '+hoyLocal()+'): '+t, btn, 'anotado ✓');
}

/* ── escribir en el tablero, con TU sesión del Portero ── */
async function llamar(action,payload){
  var cuerpo=Object.assign({action:action,k:credencial()},payload||{});
  var r=await fetch(EXEC,{method:'POST',credentials:'omit',redirect:'follow',
    headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(cuerpo)});
  var t=await r.text();
  try{ return JSON.parse(t); }catch(e){ throw new Error('El tablero contestó algo que no entiendo'); }
}

async function firmar(id,btn){
  var t=TAREAS.filter(function(x){return x.id===id;})[0]; if(!t) return;
  if(!credencial()){ alert('Primero entra con el Portero: sin credencial el tablero no deja escribir.'); return; }
  var hoy=hoyLocal();
  var texto='🤖 Ejecutado (Despacho, '+hoy+'): firmada por Alejandro desde El Despacho.';
  if(!confirm('Se va a escribir en la tarjeta '+id+':\n\n'+texto+'\n\n¿Lo firmo?')) return;
  var msj=document.getElementById('fm_'+id);
  btn.disabled=true; btn.textContent='leyendo la tarjeta…';
  try{
    /* Releer ANTES de escribir. El patch reemplaza la columna 'comentarios'
       COMPLETA: si armamos el texto con lo que teniamos cacheado desde que
       se abrio la pagina, cualquier comentario que otro haya puesto mientras
       tanto se borra. Es el mismo error que en agosto borro accesos. */
    var fresco=await llamar('getAll',{});
    if(!fresco || !fresco.ok) throw new Error('no pude releer el tablero antes de firmar');
    var actual=(fresco.tasks||[]).filter(function(x){return x.id===id;})[0];
    if(!actual) throw new Error('esa tarjeta ya no esta en el tablero');
    var prev=String(actual.comentarios||'');
    if(prev.indexOf('Ejecutado')>=0) throw new Error('ya estaba firmada desde otra pantalla');
    var linea='Claudet~'+hoy+'~'+texto;
    var nuevo=prev? (prev+'|||'+linea) : linea;
    btn.textContent='escribiendo…';
    var r=await llamar('update',{id:id,patch:{comentarios:nuevo}});
    if(!r || r.ok===false) throw new Error(r&&r.error?r.error:'el tablero no lo aceptó');
    btn.textContent='firmada ✓';
    if(msj){ msj.className='smsg ok'; msj.textContent='firmada · quedó escrita en la tarjeta'; }
    await cargar();       /* la mesa se rehace con lo que de verdad quedo escrito */
  }catch(e){
    btn.disabled=false; btn.textContent='Firmar';   /* el boton vuelve a decir lo que decia */
    if(msj){ msj.className='smsg mal'; msj.textContent='No se pudo: '+e.message; }
    else alert('No se pudo escribir: '+e.message);
  }
}


/* ── soltar un pendiente: nace como tarjeta en el Sheet, con tu sesión ── */
function llenarSoltar(){
  var proy={}, resp={};
  TAREAS.forEach(function(t){
    var p=String(t.proyecto||'').trim(); if(p) proy[p]=(proy[p]||0)+1;
    var q=String(t.responsable||'').trim(); if(q) resp[q]=(resp[q]||0)+1;
  });
  function ops(o,pri){
    var ks=Object.keys(o).sort(function(a,b){return o[b]-o[a];});
    if(pri && ks.indexOf(pri)>=0){ ks.splice(ks.indexOf(pri),1); ks.unshift(pri); }
    return ks.map(function(k){return '<option>'+esc(k)+'</option>';}).join('');
  }
  $('#sProy').innerHTML=ops(proy);
  $('#sResp').innerHTML=ops(resp,'Alejandro');
}
function fechaTexto(cual){
  var d=new Date(HOY), dow=['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
  if(cual==='semana'){ d.setDate(d.getDate()+(5-(d.getDay()||7))); if(d<HOY) d=new Date(HOY); }
  else if(cual==='proxima'){ d.setDate(d.getDate()+(12-(d.getDay()||7))); }
  var mes=['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'][d.getMonth()];
  var jue=new Date(d); jue.setDate(d.getDate()+3-((d.getDay()+6)%7));
  var sem=1+Math.round(((jue-new Date(jue.getFullYear(),0,4))/86400000-3+((new Date(jue.getFullYear(),0,4).getDay()+6)%7))/7);
  return {fecha:dow[d.getDay()]+' '+d.getDate(), mes:mes, semana:'Semana '+sem};
}
async function soltar(){
  var txt=$('#sTexto').value.trim(), m=$('#sMsg'), b=$('#sBtn');
  if(!txt){ m.className='smsg'; m.textContent='Escribe algo primero.'; return; }
  if(!credencial()){ m.className='smsg mal'; m.textContent='Entra con el Portero: sin credencial el tablero no deja escribir.'; return; }
  var f=fechaTexto($('#sFecha').value);
  var proy=$('#sProy').value, resp=$('#sResp').value;
  var emp=(TAREAS.filter(function(t){return String(t.proyecto||'').trim()===proy;})[0]||{}).empresa||'YoDesarrollo';
  b.disabled=true; m.className='smsg'; m.textContent='Escribiendo en el tablero…';
  try{
    var tarea={mes:f.mes,semana:f.semana,fecha:f.fecha,empresa:emp,proyecto:proy,responsable:resp,
               actividad:txt,estado:'Pendiente',prioridad:'Alta',entregable:'',observaciones:'',
               comentarios:'Claudet~'+hoyLocal()+'~📥 Charola (Despacho, '+hoyLocal()+'): lo soltó Alejandro, sin acomodar.'};
    var r=await llamar('create',{task:tarea});
    if(!r || r.ok===false) throw new Error(r&&r.error?r.error:'el tablero no lo aceptó');
    m.className='smsg ok'; m.textContent='Listo'+(r.task&&r.task.id?(' · '+r.task.id):'')+'. Está en la charola; yo la acomodo.';
    $('#sTexto').value='';
    await cargar();
  }catch(e){
    m.className='smsg mal'; m.textContent='No se pudo: '+e.message+'. No se escribió nada.';
  }
  b.disabled=false;
}

/* ── arranque ── */
async function cargar(){
  var b=$('#banner');
  try{
    var r=await llamar('getAll',{});
    if(!r || !r.ok) throw new Error(r&&r.error?r.error:'sin respuesta');
    TAREAS=r.tasks||[];

        +'<button class="bFirmar" data-firmar="'+esc(r.id)+'">'+(esVuelta?'Darla por cerrada':'Firmar')+'</button>'
        +'<button class="bOtro" data-cambiar="'+esc(r.id)+'">Cambiar</button>'
        +'<button class="bOtro" data-despues="'+esc(r.id)+'">Después</button>'
        +'<span class="smsg" id="fm_'+esc(r.id)+'"></span>'
      +'</div>'
      +'<div class="caja" id="cj_'+esc(r.id)+'">'
        +'<textarea id="cx_'+esc(r.id)+'" placeholder="Dicta o escribe la corrección…"></textarea>'

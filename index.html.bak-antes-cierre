/* ══════════ EL ESCRITORIO ══════════
   Cuatro zonas y un acto. Todo sale del MISMO Sheet: no hay segunda bandeja.
   Se distinguen por lo que dice el ultimo comentario de cada tarjeta:
     📥 Charola   → lo solto y todavia no lo acomodo   → charola de entrada
     ✅ DECISIÓN  → decidida; si no hay Ejecutado, va a la mesa de firmas
     🤖 Ejecutado → cerrada hoy                        → charola de salida
     ⏳ Aplazada  → contadas; tres o mas, se atora                          */

function comentarios(r){
  return String(r.comentarios||'').split('|||').map(function(c){
    var p=c.split('~'); return {autor:(p[0]||'').trim(), fecha:(p[1]||'').trim(), texto:p.slice(2).join('~').trim()};
  }).filter(function(c){ return c.texto; });
}
function enCharola(r){ var c=String(r.comentarios||''); return c.indexOf('📥 Charola')>=0 && c.indexOf('DECISIÓN')<0 && c.indexOf('Ejecutado')<0; }
function aplazos(r){ return (String(r.comentarios||'').match(/⏳ Aplazada/g)||[]).length; }
function salioHoy(r){
  var hoy=hoyLocal();
  return comentarios(r).filter(function(c){
    return c.fecha===hoy && /🤖 Ejecutado|⏳ Aplazada|✏️ Cambio pedido|📥 Charola/.test(c.texto);
  });
}
/* De que trata la decision, en las palabras que el mismo escribio */
function loQueDecidiste(r){
  var c=comentarios(r).filter(function(x){ return x.texto.indexOf('DECISIÓN')>=0; }).pop();
  if(!c) return '';
  return c.texto.replace(/^.*DECISIÓN:?\s*/,'').replace(/^(Opción|Otra)\s*[A-C]?\s*[—-]?\s*/,'').trim();
}
function loQueSalio(r){
  var c=comentarios(r).filter(function(x){ return x.texto.indexOf('Redactado')>=0; }).pop();
  return c ? c.texto.replace(/^🤖\s*Redactado:?\s*/,'').trim() : '';
}
function ramaDe(r){
  var p=String(r.proyecto||'').trim(), t=(sinac(p)==='decisiones')?temaDecision(r):p;
  var car=carrilDe(t)||'interno';
  var nom=(CARRILES.filter(function(C){return C[0]===car;})[0]||['','—'])[1];
  var meta=DICC.metas[t]||'';
  return {carril:car, carrilNombre:nom, sujeto:t||'Sin tema', meta:meta};
}


<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>El Despacho · YOD OS</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<!-- el menu lateral de YOD OS necesita SU hoja de estilo y la fuente de iconos; sin esto sale como texto pelon -->
<link rel="stylesheet" href="https://yodesarrollomx.github.io/yod-portal/os/shell.css?v=0.4.1">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.24.0/dist/tabler-icons.min.css">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap">
<style>
/* ── El Despacho · la súper app aprobada, con la mecánica de la casa ── */
/* El Despacho nace oscuro (el diseno aprobado). El shell de YOD OS trae tema
   claro y repintaba --bg dejando tinta clara sobre fondo claro: por eso la
   segunda mitad del selector, que le gana al [data-tema="claro"] del shell. */
:root,html[data-tema][data-tema]{
 --bg:#0B0A08;--panel:#17140F;--panel2:#1F1A13;--panel3:#241E16;--hair:#241E16;--hair2:#2E2718;
 --ink:#F6F1E6;--ink2:#CFC6B4;--dim:#A79C88;--faint:#6F6656;--mute:#4E4738;
 --oro:#D8AC5C;--oro2:#EFD09A;--oroS:#221C13;
 --rojo:#D8695A;--rojoS:#2E1A16;--ambar:#E0AC4A;--verde:#7FA877;--verdeS:#111A13;--azul:#86A5C9;--morado:#A98ACD;
 --serif:"Instrument Serif",Georgia,serif;--sans:"Instrument Sans",system-ui,sans-serif;--mono:"JetBrains Mono",ui-monospace,monospace;
}
*{box-sizing:border-box;margin:0}
/* el shell del OS trae su propio CSS global: aqui reclamamos lo nuestro */
.w svg,.hoja svg{max-width:none}
.w h1,.w h2,.w h3{color:var(--ink)}
html,body{background:var(--bg)}
body{color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased;
 background:radial-gradient(120% 55% at 50% -8%,#1B1710 0%,#0B0A08 58%);min-height:100vh;padding:0 0 120px}
html[data-tema][data-tema] body{color:var(--ink);
 background:radial-gradient(120% 55% at 50% -8%,#1B1710 0%,#0B0A08 58%)}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;text-align:left}
button:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--oro);outline-offset:2px}
a{color:var(--oro);text-decoration:none}a:hover{color:var(--oro2)}
.serif{font-family:var(--serif);font-weight:400}
.mono{font-family:var(--mono)}
.w{max-width:1180px;margin:0 auto;padding:0 20px}
/* barra de arriba */
.top{position:sticky;top:0;z-index:30;background:rgba(11,10,8,.86);backdrop-filter:blur(14px);border-bottom:1px solid var(--hair)}
.topin{max-width:1180px;margin:0 auto;padding:14px 20px;display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.marca{font-family:var(--serif);font-size:22px;color:var(--oro)}
.viva{display:flex;align-items:center;gap:9px;background:var(--verdeS);border:1px solid #1F3524;border-radius:20px;padding:7px 13px}
.viva .p{width:7px;height:7px;border-radius:50%;background:var(--verde);display:block}
.viva span{font-family:var(--mono);font-size:10.5px;color:var(--verde);letter-spacing:.06em}
.viva.mal{background:var(--rojoS);border-color:#4A2A24}.viva.mal .p{background:var(--rojo)}.viva.mal span{color:var(--rojo)}
.yo{margin-left:auto;width:38px;height:38px;border-radius:14px;background:var(--oro);color:#14100A;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:12px;font-weight:600}
/* saludo + hero */
.hola{padding:26px 0 4px}
.hola .d{font-size:13.5px;color:var(--dim)}
.hola h1{font-family:var(--serif);font-weight:400;font-size:clamp(30px,4vw,40px);line-height:1.05;margin-top:2px}
.hero{margin-top:16px;background:linear-gradient(160deg,#221C13 0%,#17140F 62%);border-radius:26px;padding:24px;display:flex;flex-direction:column;gap:18px}
.heroTop{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;flex-wrap:wrap}
.heroTop .k{font-family:var(--mono);font-size:9.5px;letter-spacing:.2em;color:var(--oro)}
.heroTop .n{font-family:var(--serif);font-size:clamp(42px,7vw,58px);line-height:.92}
.heroTop .n small{font-size:22px;color:var(--dim)}
.barras{display:flex;gap:7px}
.barras i{flex:1;height:5px;border-radius:3px;background:var(--panel3);display:block}
.heroPie{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}
.heroPie p{font-size:13.5px;color:var(--dim)}
.bp{background:var(--oro);color:#14100A;font-weight:600;font-size:14px;padding:12px 20px;border-radius:16px;display:inline-flex;align-items:center;gap:9px}
.bp[disabled]{opacity:.45;cursor:default}
.bo{border:1px solid var(--hair2);color:var(--ink2);font-size:13.5px;padding:11px 16px;border-radius:16px}
/* riesgos */
.rz{margin-top:16px;background:var(--rojoS);border:1px solid #4A2A24;border-radius:22px;padding:18px 20px}
.rz h2{font-family:var(--serif);font-weight:400;font-size:21px;margin-bottom:8px;color:var(--ink)}
.rzf{display:grid;grid-template-columns:92px 1fr;gap:0 16px;padding:9px 0;border-top:1px solid #3A231D}
.rzf .d{font-family:var(--mono);font-size:12px;font-weight:600;color:var(--rojo)}
.rzf b{font-weight:600;color:var(--ink);display:block;margin-bottom:2px}.rzf p{font-size:13px;color:var(--dim)}
/* soltar */
.soltar{margin-top:20px;background:var(--panel);border-radius:24px;padding:20px;display:grid;gap:12px}
.soltar h2{font-family:var(--serif);font-weight:400;font-size:22px;color:var(--ink)}
.soltar p.q{color:var(--dim);font-size:13px}
.soltar textarea{width:100%;min-height:66px;resize:vertical;background:var(--bg);border:1px solid var(--hair2);border-radius:16px;color:var(--ink);padding:13px 15px;font:inherit;line-height:1.45}
.soltar textarea::placeholder{color:var(--faint)}
.sfila{display:flex;gap:9px;align-items:center;flex-wrap:wrap}
.soltar select{background:var(--bg);color:var(--ink);border:1px solid var(--hair2);border-radius:14px;padding:10px 12px;font:inherit;font-size:13px;-webkit-appearance:none;appearance:none;min-width:120px}
.soltar select option{background:var(--panel);color:var(--ink)}
.smsg{font-family:var(--mono);font-size:10.5px;color:var(--faint);width:100%}
.smsg.mal{color:var(--rojo)}.smsg.ok{color:var(--verde)}
/* carriles + fichas */
.lane{margin-top:26px}
.laneCab{display:flex;align-items:baseline;gap:12px;margin-bottom:12px}
.laneCab h2{font-family:var(--serif);font-weight:400;font-size:24px;color:var(--ink)}
.laneCab span{font-size:12.5px;color:var(--faint)}
.laneCab .cola{margin-left:auto;font-family:var(--mono);font-size:10.5px;color:var(--faint)}
.fichas{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.ficha{background:linear-gradient(180deg,#151109 0%,#110E08 100%);border:1px solid var(--hair);border-radius:20px;padding:17px;display:flex;flex-direction:column;gap:14px;width:100%;
 box-shadow:0 1px 0 rgba(255,255,255,.03) inset,0 16px 34px rgba(0,0,0,.3);transition:border-color .15s,transform .15s}
.ficha:hover{border-color:var(--hair2);transform:translateY(-2px)}
.ficha.hot{border-color:#4A2A24}
.ficha.sel{border-color:var(--oro)}
.fCab{display:flex;gap:12px;align-items:flex-start}
.fCab svg{width:52px;height:52px;border-radius:12px;flex:none;display:block}
.fCab .t{min-width:0;display:flex;flex-direction:column;gap:4px}
.fCab h3{font-family:var(--serif);font-weight:400;font-size:21px;line-height:1.1}
.fCab .m{font-family:var(--mono);font-size:9.5px;letter-spacing:.1em;color:var(--oro)}
.marcas{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #1F1A11;padding-top:12px}
.mrc{display:flex;flex-direction:column;gap:3px}
.mrc b{font-family:var(--mono);font-size:19px;font-weight:600;line-height:1;font-variant-numeric:tabular-nums}
.mrc b.al{color:var(--rojo)}.mrc b.am{color:var(--ambar)}.mrc b.na{color:var(--faint);font-size:13px}
.mrc b.or{color:var(--oro);font-size:15px}
.mrc span{font-family:var(--mono);font-size:8px;letter-spacing:.13em;color:var(--faint)}
.riel{position:relative;height:4px;background:#1F1A11;border-radius:2px}
.riel .zona{position:absolute;left:47%;right:0;top:0;bottom:0;border-radius:0 2px 2px 0}
.riel .pt{position:absolute;top:-3px;width:10px;height:10px;border-radius:50%}
.pins{display:flex;gap:6px;flex-wrap:wrap;margin-top:auto}
.pin{font-family:var(--mono);font-size:9px;letter-spacing:.09em;padding:3px 8px;border:1px solid;border-radius:8px}
.pin.d{color:var(--rojo);border-color:var(--rojo);background:var(--rojoS)}
.pin.v{color:var(--ambar);border-color:#4A3C1E}
.pin.e{color:var(--azul);border-color:#2A3A4A;background:#121820}
.pin.m{color:var(--oro);border-color:var(--hair2)}
.limpio{border:1px dashed var(--hair2);border-radius:20px;padding:20px;display:flex;align-items:center;gap:12px;color:var(--faint);font-size:13.5px}
.limpio i{width:8px;height:8px;border-radius:50%;background:var(--verde);display:block;flex:none}
/* hoja de detalle */
.velo{position:fixed;inset:0;background:rgba(6,5,4,.6);z-index:40;display:none}
.velo.on{display:block}
.hoja{position:fixed;left:0;right:0;bottom:0;max-height:88vh;background:#100E0A;border-radius:28px 28px 0 0;z-index:50;
 box-shadow:0 -18px 44px rgba(0,0,0,.55);display:none;flex-direction:column;overflow:hidden}
.hoja.on{display:flex}
.grab{display:flex;justify-content:center;padding:11px 0 4px}
.grab i{width:38px;height:4px;border-radius:3px;background:#2C2519;display:block}
.hCab{padding:8px 22px 16px;display:flex;gap:14px;align-items:flex-start;max-width:1180px;margin:0 auto;width:100%}
.hCab svg{width:56px;height:56px;border-radius:14px;flex:none;display:block}
.hCab .t{flex:1;min-width:0;display:flex;flex-direction:column;gap:5px}
.hCab h3{font-family:var(--serif);font-weight:400;font-size:28px;line-height:1.05}
.hCab .m{font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:var(--oro)}
.hX{width:34px;height:34px;border-radius:12px;background:var(--panel3);display:flex;align-items:center;justify-content:center;flex:none}
.hStats{padding:0 22px 14px;display:grid;grid-template-columns:repeat(4,1fr);gap:10px;max-width:1180px;margin:0 auto;width:100%}
.hStats div{background:var(--panel);border-radius:16px;padding:12px 14px;display:flex;flex-direction:column;gap:3px}
.hStats b{font-family:var(--mono);font-size:20px;font-weight:600;line-height:1}
.hStats span{font-family:var(--mono);font-size:8px;letter-spacing:.12em;color:var(--faint)}
.hLista{flex:1;overflow:auto;padding:0 22px 8px;max-width:1180px;margin:0 auto;width:100%}
.row{display:flex;align-items:flex-start;gap:12px;padding:14px 0;border-bottom:1px solid #1C1811}
.row .b{width:9px;height:9px;border-radius:50%;margin-top:5px;flex:none}
.row .c{flex:1;min-width:0;display:flex;flex-direction:column;gap:4px}
.row .c b{font-size:14.5px;font-weight:400}
.row .c .mm{font-family:var(--mono);font-size:10px;color:var(--faint)}
.row .ac{flex:none}
.bFirmar{background:var(--oro);color:#14100A;font-weight:600;font-size:12.5px;padding:9px 14px;border-radius:12px}
.bFirmar[disabled]{opacity:.45;cursor:default}
.hPie{padding:14px 22px 26px;border-top:1px solid #1C1811;font-family:var(--mono);font-size:10px;color:var(--faint);max-width:1180px;margin:0 auto;width:100%}
/* focos */
.focos{margin-top:34px}
.focos h2{font-family:var(--serif);font-weight:400;font-size:24px;margin-bottom:12px;color:var(--ink)}
.fgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:10px}
.foco{display:grid;grid-template-columns:20px 1fr;gap:11px;background:var(--panel);border-radius:16px;padding:13px 15px;align-items:start}
.foco i{width:12px;height:12px;border-radius:4px;margin-top:3px;display:block}
.foco i.ok{background:var(--verde)}.foco i.no{background:var(--rojo)}
.foco b{display:block;font-size:13.5px;font-weight:500}
.foco span{font-size:12.5px;color:var(--dim)}
.pie{margin-top:30px;font-family:var(--mono);font-size:10px;color:var(--mute);letter-spacing:.06em}
.aviso{margin-top:16px;background:var(--panel);border:1px solid var(--hair2);border-radius:20px;padding:16px 18px;font-size:14px;color:var(--dim)}
.aviso.mal{border-color:#4A2A24;background:var(--rojoS);color:var(--ink)}
@media(max-width:900px){.fichas{grid-template-columns:1fr}.hStats{grid-template-columns:repeat(2,1fr)}}

/* Anclaje de tema. portero.js inyecta su hoja DESPUES de esta y en claro
   repinta .hero (con !important) y .pie. Aqui vuelven al oscuro aprobado. */
html[data-tema][data-tema] .hero{background:linear-gradient(160deg,#221C13 0%,#17140F 62%)!important}
html[data-tema][data-tema] .pie{background:none}
/* El shell de YOD OS pinta su lienzo claro (.yod-canvas{background:#f6f3ed})
   y su tinta oscura (.yod-shell{color:var(--ytext)}) porque los demas
   tableros son claros. El Despacho es oscuro: se le devuelve el lienzo.
   Solo el lienzo: la barra lateral y la de arriba son hermanas y no se tocan. */
body .yod-canvas{background:var(--bg);color:var(--ink)}
/* ══════════ LA CHAROLA DEL DIRECTOR ══════════
   El boceto que Alejandro aprobo el 7-sep: un escritorio con tres charolas —
   lo que entra, lo que ya acomode, y lo que salio firmado. El centro no es una
   lista: es un acto. Firmar. */
.acuerdo{margin-top:16px;background:linear-gradient(160deg,#221C13 0%,#17140F 62%);border-radius:24px;padding:22px 24px}
.acuerdo .k{font-family:var(--mono);font-size:9.5px;letter-spacing:.2em;color:var(--oro)}
.acuerdo .n{font-family:var(--serif);font-size:clamp(30px,4.4vw,44px);line-height:1.05;color:var(--ink);margin-top:4px}
.acuerdo .n em{font-style:normal;color:var(--oro)}
.acuerdo .sub{font-size:13.5px;color:var(--dim);margin-top:8px}
.tres{display:grid;grid-template-columns:0.9fr 1.25fr 0.85fr;gap:14px;margin-top:14px;align-items:start}
@media(max-width:1080px){.tres{grid-template-columns:1fr}}
.dos{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}
@media(max-width:820px){.dos{grid-template-columns:1fr}}
.zona{background:var(--panel);border:1px solid var(--hair);border-radius:22px;padding:18px 18px 16px}
.zona>h2{font-family:var(--serif);font-size:21px;color:var(--ink);line-height:1.15}
.zona>.sub{display:block;font-size:12px;color:var(--faint);margin:2px 0 14px}
.zona.entrada{border-color:#25402C}
.zona.mesa{border-color:#4A3C1E;background:linear-gradient(180deg,#1B1710 0%,#141109 100%)}
.zona.arbol{border-color:#2E2545}
.zona.salida{border-color:#2A3A4A}
.zona.atora{border-color:#4A2A24;background:var(--rojoS)}
/* ── el boton grande de grabar ── */
.mic{width:100%;display:flex;align-items:center;justify-content:center;gap:11px;background:var(--verdeS);
  border:1px solid #2C5138;color:var(--verde);border-radius:18px;padding:18px;font-size:15px;font-weight:600;transition:.15s}
.mic:hover{border-color:var(--verde)}
.mic i{width:12px;height:12px;border-radius:50%;background:var(--verde);display:block}
.mic.on{background:var(--rojoS);border-color:var(--rojo);color:var(--rojo)}
.mic.on i{background:var(--rojo);animation:lat 1s infinite}
@keyframes lat{50%{opacity:.25}}
.mic[disabled]{opacity:.45}
.micEst{font-size:12px;color:var(--faint);text-align:center;margin:8px 0 12px;min-height:16px}
.zona textarea{width:100%;min-height:88px;background:var(--panel2);border:1px solid var(--hair2);border-radius:14px;
  padding:13px 14px;color:var(--ink);font:inherit;font-size:14px;resize:vertical}
.zona textarea:focus{outline:2px solid var(--oro);outline-offset:2px}
.zona select{background:var(--panel2);border:1px solid var(--hair2);border-radius:12px;padding:9px 11px;color:var(--ink2);font:inherit;font-size:12.5px}
.dicPie{display:flex;gap:7px;flex-wrap:wrap;margin-top:11px;align-items:center}
.dicPie .bp{padding:10px 16px;font-size:13px}
.smsg{font-size:12px;color:var(--dim);flex:1 0 100%}
.smsg.ok{color:var(--verde)} .smsg.mal{color:var(--rojo)}
/* ── la tarjeta de la mesa: grande, se lee en diez segundos ── */
.firma{background:var(--panel2);border:1px solid var(--hair2);border-radius:18px;padding:16px 17px;margin-bottom:11px}
.firma.hot{border-color:#4A3C1E}
.firma .rama{font-family:var(--mono);font-size:9.5px;letter-spacing:.14em;color:var(--oro);text-transform:uppercase}
.firma h3{font-family:var(--serif);font-size:19px;line-height:1.2;color:var(--ink);margin:5px 0 9px}
.firma .por{font-size:13.5px;color:var(--ink2);line-height:1.5;border-left:2px solid var(--hair2);padding-left:11px;margin-bottom:10px}
.firma .por b{color:var(--ink);font-weight:600}
.firma .meta{font-family:var(--mono);font-size:10.5px;color:var(--faint);margin-bottom:12px}
.firma .acc{display:flex;gap:7px;flex-wrap:wrap}
.bFirmar{background:var(--oro);color:#14100A;font-weight:600;font-size:12.5px;padding:9px 15px;border-radius:12px}
.bOtro{background:transparent;border:1px solid var(--hair2);color:var(--ink2);font-size:12.5px;padding:9px 14px;border-radius:12px}
.bOtro:hover{border-color:var(--dim);color:var(--ink)}
.bFirmar[disabled],.bOtro[disabled]{opacity:.4;cursor:default}
.firma .caja{margin-top:11px;display:none}
.firma .caja.on{display:block}
.vacio{font-size:13.5px;color:var(--dim);background:var(--panel2);border:1px dashed var(--hair2);border-radius:16px;padding:18px;text-align:center}
/* ── el arbol: solo se prende la rama de la tarjeta abierta ── */
.rama{margin-bottom:4px}
.ramaT{display:flex;align-items:center;gap:8px;font-family:var(--mono);font-size:10px;letter-spacing:.14em;
  text-transform:uppercase;color:var(--faint);padding:7px 0}
.ramaT i{width:5px;height:5px;border-radius:50%;background:var(--mute)}
.hoja2{display:flex;align-items:center;gap:9px;padding:6px 0 6px 14px;border-left:1px solid var(--hair2);
  font-size:13px;color:var(--faint);transition:.15s}
.hoja2 b{font-weight:500;color:var(--dim)}
.hoja2 .cu{margin-left:auto;font-family:var(--mono);font-size:10px}
.rama.on .ramaT{color:var(--oro)} .rama.on .ramaT i{background:var(--oro)}
.rama.on .hoja2{border-left-color:var(--oro);color:var(--ink2)}
.rama.on .hoja2 b{color:var(--ink)}
.rama.on .hoja2.esa{background:var(--oroS);border-radius:0 10px 10px 0}
.rama.on .hoja2.esa b{color:var(--oro2)}
/* ── salida y atoro ── */
.sal{display:flex;gap:10px;align-items:flex-start;padding:9px 0;border-bottom:1px solid var(--hair)}
.sal:last-child{border-bottom:0}
.sal .h{font-family:var(--mono);font-size:10px;color:var(--faint);min-width:44px}
.sal .t{font-size:13.5px;color:var(--ink2);line-height:1.45}
.sal .t em{font-style:normal;color:var(--verde)}
.at{padding:9px 0;border-bottom:1px solid #3A231D}
.at:last-child{border-bottom:0}
.at b{display:block;font-size:14px;color:var(--ink)}
.at span{font-size:12.5px;color:var(--rojo)}

</style>
</head>
<body>
<div class="top"><div class="topin">
  <span class="marca">El Despacho</span>
  <span class="viva" id="viva"><span class="p"></span><span id="estado">leyendo tu tablero…</span></span>
  <span class="yo">AP</span>
</div></div>

<div class="w">
  <div class="hola">
    <p class="d" id="hoy"></p>

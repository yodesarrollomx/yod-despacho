/* ── 3 · la mesa de firmas ── */
var MESA=[];
function armarMesa(){
  MESA=[];
  VIVAS.forEach(function(r){
    var d=dias(r._f), ap=aplazos(r);
    if(r._dec)      MESA.push({r:r, clase:'firmar', ap:ap});
    else if(r._esp && d!==null && d>7) MESA.push({r:r, clase:'vuelta', ap:ap});
  });
  MESA.sort(function(a,b){
    if(a.clase!==b.clase) return a.clase==='firmar'?-1:1;
    return (dias(b.r._f)||0)-(dias(a.r._f)||0);
  });
}

function fmtDias(n){ if(n===null||n===undefined) return null; if(n>0) return n+' d'; if(n===0) return 'hoy'; return 'en '+(-n)+' d'; }
function lunesISO(sem){ var d=new Date(Date.UTC(ANIO,0,4)); var day=d.getUTCDay()||7; d.setUTCDate(d.getUTCDate()-day+1+(sem-1)*7); return d; }

/* ── la fecha real: el Sheet guarda "Lunes 24" y el mes aparte ── */
function fechaReal(r){
  var f=String(r.fecha||''), fs=sinac(f), mes0=MESES[sinac(r.mes)];
  var m=f.match(/(\d{4})-(\d{2})-(\d{2})/);
  if(m) return [new Date(+m[1],+m[2]-1,+m[3]),'explicita'];
  m=f.match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/);
  if(m) return [new Date(+m[3],+m[2]-1,+m[1]),'explicita'];
  if(!/\d/.test(f)){
    var mm=fs.match(/fin de ([a-z]+)/);
    if(fs.indexOf('fin de mes')>=0 || mm){
      var k=MESES[mm?mm[1]:''] || mes0;
      if(k) return [new Date(ANIO,k,0),'deducida (fin de mes)'];
    }
    if(/esta seman|est[ae] sem/.test(fs)){
      var ws=String(r.semana||'').match(/(\d{1,2})/);
      if(ws){ var L=lunesISO(+ws[1]); return [new Date(L.getUTCFullYear(),L.getUTCMonth(),L.getUTCDate()+4),'deducida (viernes de la semana)']; }
    }
    return [null,'sin fecha en el Sheet'];
  }
  var d1=f.match(/(\d{1,2})/);
  if(d1 && mes0) return [new Date(ANIO,mes0-1,+d1[1]),'deducida'];
  return [null,'sin fecha en el Sheet'];
}

function dinero(r){
  var t=[r.actividad,r.observaciones,r.entregable,r.comentarios].join(' ');
  var re=/\$\s?(\d[\d,\.]*)\s?([kKmM]{1,2}|mil|millones)?/g, mx=0, txt='', m;
  while((m=re.exec(t))){
    var num=m[1].replace(/[.,]+$/,''), suf=(m[2]||'').toLowerCase();
    var v=parseFloat(num.replace(/,/g,'')); if(isNaN(v)) continue;
    if(suf==='k'||suf==='mil') v*=1e3; else if(suf==='m'||suf==='mm'||suf==='millones') v*=1e6;
    if(v>mx){ mx=v; txt='$'+num+(m[2]||''); }
  }
  return [mx,txt];
}
/* Una decision tomada tiene TRES estados, no dos, y confundirlos es la razon
   por la que "el pendiente casi nunca muere":
     te toca   -> la decidiste y nadie ha redactado nada: es tuya, hoy.
     esperando -> ya se redacto lo que salia de esa decision y ahora depende de
                  otra persona. Sigue viva, pero NO te esta pidiendo nada.
     ejecutada -> se cerro. Deja de contar.
   Antes las dos primeras se contaban juntas y el numero grande nunca bajaba,
   asi que dejaba de significar algo. */
function estadoDecision(r){
  var c=String(r.comentarios||'');
  if(c.indexOf('DECISIÓN')<0 && c.indexOf('DECISION')<0) return '';
  if(c.indexOf('Ejecutado')>=0) return 'ejecutada';
  if(c.indexOf('Redactado')>=0) return 'esperando';
  return 'tetoca';
}
function decisionSinEjecutar(r){ return estadoDecision(r)==='tetoca'; }
function carrilDe(p){
  var ps=sinac(p);
  var g=['proyectos','nuevos','interno'];
  for(var i=0;i<g.length;i++){ var L=MAPA[g[i]]||[]; for(var j=0;j<L.length;j++) if(sinac(L[j])===ps) return g[i]; }
  return null;
}
function temaDecision(r){
  var a=String(r.actividad||''), m=a.match(/·\s*([^—\-]{2,40})/);
  var crudo=sinac(m?m[1]:a), al=MAPA.alias_tema||{};
  for(var k in al) if(crudo.indexOf(sinac(k))>=0) return al[k];
  return null;
}
function tipoDe(r){
  var p=sinac(r.proyecto), a=String(r.actividad||'');
  if(p==='decisiones' || /^\s*D-\d+/.test(a)) return 'D';
  var t=a+' '+String(r.observaciones||'');
  if(/pag|abono|n[oó]mina|factura|cobr|dep[oó]sito|transferen/i.test(t)) return 'P';
  if(/reuni[oó]n|junta|llamada|cita/i.test(t)) return 'R';
  if(/entreg|plano|expediente|documento|contrato|carta/i.test(t)) return 'E';
  return 'A';
}
function matricula(r,suj){
  var emp = String(r.empresa||'').indexOf('Aurum')>=0 ? 'AU':'YD';
  var su = DICC.sujetos[suj] || DICC.personas[suj] || '???';
  var m = String(r.actividad||'').match(/D-(\d+)/);
  var num = m ? 'D'+('00'+m[1]).slice(-3) : (tipoDe(r)+('00'+(String(r.id||'').match(/(\d+)/)||['','000'])[1]).slice(-3));
  var meta = DICC.metas[suj] || 'M?';
  var q = DICC.personas[String(r.responsable||'').trim()] || '???';
  return [emp,su,num,meta,q].join('-');
}

/* ── portada determinista por sigla + carril ── */
var TINTE={proyectos:['#2f6340','#e3ede2'],nuevos:['#9a7220','#f4ead2'],colaboradores:['#3d5f86','#e2eaf2'],brokers:['#6a4b8c','#ece4f4'],interno:['#a2402f','#f7e5e0']};
function semilla(s){ var h=2166136261; for(var i=0;i<s.length;i++){ h^=s.charCodeAt(i); h=(h*16777619)>>>0; } return h; }
function portada(sig,carril){

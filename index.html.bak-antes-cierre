/* ══════════ EL BOTÓN GRANDE: dictado del navegador ══════════
   Alejandro aprieta y habla; el navegador lo pasa a texto en vivo. No guarda
   el archivo — todavia. Cuando el Apps Script del board sepa recibir un audio,
   este MISMO boton empieza a guardarlo tambien, sin rehacer nada: por eso la
   grabacion vive en una funcion aparte y no pegada al textarea. */
var REC=null, RECdest=null, RECbtn=null, RECbase='';
function hayDictado(){ return !!(window.SpeechRecognition||window.webkitSpeechRecognition); }
function dictarEn(dest, btn){
  if(!hayDictado()){
    if(btn) btn.textContent='tu navegador no oye';
    return;
  }
  if(REC){ REC.stop(); return; }
  var SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  REC=new SR(); RECdest=dest; RECbtn=btn; RECbase=dest.value?dest.value+' ':'';
  REC.lang='es-MX'; REC.continuous=true; REC.interimResults=true;
  REC.onstart=function(){ marcarGrabando(true); };
  REC.onresult=function(e){
    var t='';
    for(var i=0;i<e.results.length;i++) t+=e.results[i][0].transcript;
    dest.value=RECbase+t;
  };
  REC.onerror=function(e){
    marcarGrabando(false);
    var m=$('#micEst'); if(m) m.textContent = (e.error==='not-allowed')
      ? 'Chrome no me dejó oír: dale permiso de micrófono al sitio y vuelve a apretar.'
      : 'No pude oír ('+e.error+'). Escríbelo si urge.';
  };
  REC.onend=function(){ marcarGrabando(false); REC=null; };
  try{ REC.start(); }catch(e){ REC=null; marcarGrabando(false); }
}
function marcarGrabando(on){
  var b=$('#micBtn'), t=$('#micTxt'), m=$('#micEst');
  if(RECbtn && RECbtn!==b){ RECbtn.textContent = on?'⏹ Parar':'🎙 Dictar'; }
  if(b && (!RECdest || RECdest===$('#sTexto'))){
    b.classList.toggle('on',on);
    if(t) t.textContent = on?'Te estoy oyendo — aprieta para parar':'Grabar';
  }
  if(m && (!RECdest || RECdest===$('#sTexto')))
    m.textContent = on?'Habla normal. Cuando pares, lo dejo escrito abajo.':'Apriétalo y habla. Yo lo escribo.';
}

